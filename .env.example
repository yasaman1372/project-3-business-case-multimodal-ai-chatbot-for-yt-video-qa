# Copy this file to .env and fill in your keys. Never commit .env.

# OpenAI (LLM, embeddings, Whisper)
OPENAI_API_KEY=

# YouTube Data API v3 (video search)
YOUTUBE_API_KEY=

# Transcript service (recommended): fetches YouTube captions without being rate-limited
SUPADATA_API_KEY=

# Optional: proxy for YouTube transcript downloads (needed on Vercel / when YouTube blocks your IP)
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
# or any proxy: TRANSCRIPT_PROXY_URL=http://user:pass@host:port

# Pinecone (vector database)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=yt-video-qa

# Postgres (conversation memory). Required on Vercel; leave empty locally to keep chats in RAM.
# On Neon, use the pooled connection string.
DATABASE_URL=

# LangSmith (tracing + evaluation)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=yt-video-qa
